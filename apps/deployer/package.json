{
  "name": "veltron-deployer-checks",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test:e2e": "playwright test",
    "build": "esbuild src/wallet.js --bundle --format=esm --outfile=dist/wallet.js",
    "test:executor": "node --test tests/meteor-executor.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:all": "npm run test:executor && npm run test:deployment"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@hot-labs/near-connect": "0.11.4",
    "esbuild": "0.25.11"
  }
}
