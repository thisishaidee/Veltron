{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veltron-audit-indexer",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": ["INDEXER_TRIGGER_TOKEN"]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "veltron-audit-index",
      "database_id": "1a2c1f9c-d6a0-48c0-829c-a8e840c9913b"
    }
  ],
  "vars": {
    "NETWORK": "testnet",
    "TREASURY_ACCOUNT": "veltron-treasury.testnet",
    "START_BLOCK_HEIGHT": "277136692",
    "MAX_BLOCKS_PER_TICK": "500"
  }
}
